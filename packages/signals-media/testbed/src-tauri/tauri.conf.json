{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "signals-media-testbed",
  "version": "0.0.1",
  "identifier": "org.lightningrodlabs.signals-media-testbed",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm --prefix ../ run build",
    "beforeDevCommand": "npm --prefix ../ run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
